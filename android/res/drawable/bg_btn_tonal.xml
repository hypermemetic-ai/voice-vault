<?xml version="1.0" encoding="utf-8"?>
<!-- 40dp visual button inside a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="4dp" android:insetBottom="4dp">
    <ripple android:color="#1FFFFFFF">
        <item>
            <selector>
                <item android:state_enabled="false">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/surface" />
                        <corners android:radius="@dimen/radius_control" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/surface_raised" />
                        <corners android:radius="@dimen/radius_control" />
                    </shape>
                </item>
            </selector>
        </item>
    </ripple>
</inset>
