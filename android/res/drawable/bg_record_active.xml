<?xml version="1.0" encoding="utf-8"?>
<!-- Record control, recording: the same ring turns red around a stop square. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/record" />
        </shape>
    </item>
</ripple>
