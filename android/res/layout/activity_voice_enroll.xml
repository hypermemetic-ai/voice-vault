<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <!-- Top bar: title and close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/VV.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enroll your voice" />

                <ImageButton
                    android:id="@+id/btn_close_enroll"
                    style="@style/VV.IconButton"
                    android:layout_marginEnd="-14dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close enrollment"
                    android:tooltipText="Close" />
            </LinearLayout>

            <TextView
                style="@style/VV.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                android:textColor="@color/text_faint"
                android:textSize="12sp"
                android:text="Record three clips of about five seconds each. Voice Vault learns your vocal signature on the server and rejects other voices in the room before transcription." />

            <TextView
                android:id="@+id/tv_slot_1"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 1 · not recorded" />

            <TextView
                android:id="@+id/tv_slot_2"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 2 · not recorded" />

            <TextView
                android:id="@+id/tv_slot_3"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 3 · not recorded" />

            <TextView
                android:id="@+id/tv_enroll_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xl"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:fontFamily="@font/urw_gothic_demi" />

            <Button
                android:id="@+id/btn_record_clip"
                style="@style/VV.Button.Record"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="RECORD CLIP" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_xs">

                <Button
                    android:id="@+id/btn_submit_enroll"
                    style="@style/VV.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="ENROLL VOICE" />

                <Button
                    android:id="@+id/btn_test_voice"
                    style="@style/VV.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xs"
                    android:text="TEST MY VOICE" />
            </LinearLayout>

            <!-- Profile status: plain text, no surface. -->
            <TextView
                android:id="@+id/tv_enroll_status"
                style="@style/VV.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="Checking voice profile…" />

            <TextView
                android:id="@+id/tv_enroll_result"
                style="@style/VV.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text=""
                android:textColor="@color/success"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_remove_profile"
                style="@style/VV.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginStart="-12dp"
                android:textColor="@color/record"
                android:text="REMOVE VOICE PROFILE"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
