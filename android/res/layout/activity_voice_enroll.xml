<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ENROLL YOUR VOICE"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urw_gothic_demi"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btn_close_enroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:padding="6dp"
                    android:clickable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Record three clips of about five seconds each. Voice Vault learns your vocal signature on the server and rejects other voices in the room before transcription."
                android:textColor="#777777"
                android:textSize="12sp"
                android:fontFamily="@font/urw_gothic_book"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="18dp" />

            <!-- Clip slots -->
            <TextView
                android:id="@+id/tv_slot_1"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 1 · not recorded" />

            <TextView
                android:id="@+id/tv_slot_2"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 2 · not recorded" />

            <TextView
                android:id="@+id/tv_slot_3"
                style="@style/VoiceVaultClipSlot"
                android:text="Clip 3 · not recorded" />

            <TextView
                android:id="@+id/tv_enroll_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/urw_gothic_demi"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_record_clip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_red"
                android:text="● RECORD CLIP"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/urw_gothic_demi"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_submit_enroll"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#1C1C1C"
                    android:text="ENROLL VOICE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/urw_gothic_demi" />

                <Button
                    android:id="@+id/btn_test_voice"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#1C1C1C"
                    android:text="TEST MY VOICE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/urw_gothic_demi" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_remove_profile"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#120808"
                android:text="REMOVE VOICE PROFILE"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:fontFamily="@font/urw_gothic_demi"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_enroll_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking voice profile…"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                android:fontFamily="@font/urw_gothic_book"
                android:lineSpacingMultiplier="1.4" />

            <TextView
                android:id="@+id/tv_enroll_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:fontFamily="@font/urw_gothic_book"
                android:lineSpacingMultiplier="1.4"
                android:paddingTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
