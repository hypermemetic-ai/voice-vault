<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main Dashboard Screen.
         fillViewport + wrap_content column keeps the dashboard centered and
         full-height in portrait, while short viewports (landscape, multi-window,
         expanded transcripts) scroll instead of clipping the record control. -->
    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_l">

        <!-- Top bar: History, title, Setup. Icon glyphs sit on the content edge. -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_open_history"
                style="@style/VV.IconButton"
                android:layout_marginStart="-14dp"
                android:src="@drawable/ic_history"
                android:contentDescription="History"
                android:tooltipText="History" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xs"
                style="@style/VV.Title"
                android:textColor="@color/text_muted"
                android:text="Voice Vault" />

            <ImageButton
                android:id="@+id/btn_open_setup"
                style="@style/VV.IconButton"
                android:layout_marginEnd="-14dp"
                android:src="@drawable/ic_tune"
                android:contentDescription="Setup and diagnostics"
                android:tooltipText="Setup" />
        </LinearLayout>

        <!-- Setup warning: plain red line, the whole row opens Setup. -->
        <LinearLayout
            android:id="@+id/banner_setup_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_row"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_setup_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/record"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/urw_gothic_book" />
        </LinearLayout>

        <!-- Record control: state, timer, button, then connection / mode.
             The weight gives it every spare pixel in portrait; minHeight keeps
             it intact when space runs out (the page scrolls instead). -->
        <LinearLayout
            android:id="@+id/record_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="300dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pb_gpu_spinner"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="@dimen/space_s"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/text_muted"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_record_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/VV.Label"
                    android:text="Ready" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_xl"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/text_muted"
                android:textSize="56sp"
                android:fontFamily="@font/urw_gothic_demi" />

            <ImageButton
                android:id="@+id/btn_record"
                android:layout_width="@dimen/record_button"
                android:layout_height="@dimen/record_button"
                android:background="@drawable/bg_record_idle"
                android:src="@drawable/ic_record_core"
                android:scaleType="center"
                android:contentDescription="Record or Stop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_connection_status"
                    style="@style/VV.Status"
                    android:text="Checking server" />

                <TextView
                    android:id="@+id/tv_dictation_mode"
                    style="@style/VV.Status"
                    android:layout_marginStart="@dimen/space_xl"
                    android:text="Dictation Mode off" />
            </LinearLayout>
        </LinearLayout>

        <!-- Latest transcript -->
        <LinearLayout
            android:id="@+id/layout_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_l"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/VV.Label"
                    android:text="Latest transcript" />

                <Button
                    android:id="@+id/btn_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/VV.Button.Text"
                    android:text="Expand" />

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-12dp"
                    style="@style/VV.Button.Text"
                    android:text="Copy" />
            </LinearLayout>

            <!-- Compact by default (3 lines). Expanding gives the ScrollView a
                 bounded height so the transcript scrolls inside it instead of
                 pushing the record button off-screen. -->
            <ScrollView
                android:id="@+id/sv_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <EditText
                    android:id="@+id/et_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:padding="0dp"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:fontFamily="@font/urw_gothic_book"
                    android:background="@null"
                    android:lineSpacingMultiplier="1.3"
                    android:inputType="textMultiLine"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:clickable="true"
                    android:scrollbars="none" />
            </ScrollView>
        </LinearLayout>

        <!-- Settings: three plain rows, no surfaces. -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_auto_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-send"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:fontFamily="@font/urw_gothic_book" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sends after Vol Down inserts the text"
                        android:textColor="@color/text_faint"
                        android:textSize="12sp"
                        android:fontFamily="@font/urw_gothic_book" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkbox_auto_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-6dp"
                    android:buttonTint="@color/text"
                    android:contentDescription="Auto-send" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_voice_profile"
                style="@style/VV.Row"
                android:minHeight="56dp"
                android:text="Voice Gate" />

            <Button
                android:id="@+id/btn_toggle_overlay"
                style="@style/VV.Row"
                android:minHeight="56dp"
                android:text="Floating bubble" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Scrim (Dim Background on Drawer Open) -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true" />

    <!-- Slide-Out History Drawer Panel -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:visibility="gone"
        android:clickable="true">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/VV.Title"
                android:text="History" />

            <ImageButton
                android:id="@+id/btn_close_drawer"
                style="@style/VV.IconButton"
                android:layout_marginEnd="-14dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Close history"
                android:tooltipText="Close" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_history_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last 50 transcriptions · tap one to copy"
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            android:fontFamily="@font/urw_gothic_book" />

        <!-- History Items ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
