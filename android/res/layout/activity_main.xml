<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Main Dashboard Screen.
         fillViewport + wrap_content column keeps the dashboard centered and
         full-height in portrait, while short viewports (landscape, multi-window,
         expanded transcripts) scroll instead of clipping the record control. -->
    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- Top Bar with History Toggle, GPU Indicator & Processing Spinner -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btn_open_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:paddingEnd="14dp"
                android:clickable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOICE VAULT"
                android:textColor="#777777"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/urw_gothic_demi"
                android:letterSpacing="0.1" />

            <ProgressBar
                android:id="@+id/pb_gpu_spinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RTX A2000"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/urw_gothic_demi" />
        </LinearLayout>

        <!-- Center Dictation Control: Centered and Balanced.
             wrap_content + weight lets the ScrollView give it every spare pixel
             in portrait; minHeight keeps the timer + 210dp record button intact
             when space runs out (the page scrolls instead of clipping). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="250dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="58sp"
                android:textStyle="bold"
                android:fontFamily="@font/urw_gothic_demi"
                android:layout_marginBottom="32dp" />

            <!-- Massive Symbol Button with Big Shapes -->
            <ImageButton
                android:id="@+id/btn_record"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:background="@drawable/bg_btn_idle"
                android:src="@drawable/ic_btn_record_symbol"
                android:scaleType="centerInside"
                android:contentDescription="Record or Stop" />
        </LinearLayout>

        <!-- Result / Transcript Section -->
        <LinearLayout
            android:id="@+id/layout_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#080808"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COPIED TO CLIPBOARD"
                    android:textColor="#22C55E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urw_gothic_demi"
                    android:letterSpacing="0.06" />

                <Button
                    android:id="@+id/btn_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="#1C1C1C"
                    android:text="EXPAND"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/urw_gothic_demi" />

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#1C1C1C"
                    android:text="COPY"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/urw_gothic_demi" />
            </LinearLayout>

            <!-- Compact by default (3 lines, ellipsized). Expanding gives the
                 ScrollView a bounded height so the transcript scrolls inside it
                 instead of pushing the record button off-screen. -->
            <ScrollView
                android:id="@+id/sv_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <EditText
                    android:id="@+id/et_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/urw_gothic_book"
                    android:background="@null"
                    android:lineSpacingMultiplier="1.3"
                    android:inputType="textMultiLine"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:clickable="true"
                    android:scrollbars="none" />
            </ScrollView>
        </LinearLayout>

        <!-- Hardware & Gesture Quick Guide Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btn_voice_profile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@null"
                android:text="🎙 Voice Gate: …"
                android:textColor="#555555"
                android:textSize="11sp"
                android:fontFamily="@font/urw_gothic_book" />

            <Button
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@null"
                android:text="⊚ Floating Bubble"
                android:textColor="#555555"
                android:textSize="11sp"
                android:fontFamily="@font/urw_gothic_book" />
        </LinearLayout>

        <!-- Dictation Settings: Volume-Key Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp">

            <CheckBox
                android:id="@+id/checkbox_auto_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-send on paste (Vol Dn)"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:fontFamily="@font/urw_gothic_book" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Scrim (Dim Background on Drawer Open) -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true" />

    <!-- Slide-Out History Drawer Panel -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#0A0A0A"
        android:elevation="24dp"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRANSCRIPTS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/urw_gothic_demi"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btn_close_drawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#888888"
                android:textSize="18sp"
                android:padding="6dp"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_history_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last 50 Transcriptions · Tap to copy"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="@font/urw_gothic_book"
            android:layout_marginBottom="16dp" />

        <!-- History Items ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
