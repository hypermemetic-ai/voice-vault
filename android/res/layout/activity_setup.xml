<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <!-- Top bar: title and close, as in the History drawer. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/VV.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SETUP &amp; DIAGNOSTICS" />

                <ImageButton
                    android:id="@+id/btn_close_setup"
                    style="@style/VV.IconButton"
                    android:layout_marginEnd="-14dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close setup"
                    android:tooltipText="Close" />
            </LinearLayout>

            <TextView
                style="@style/VV.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_faint"
                android:textSize="12sp"
                android:text="Every APK update can silently reset Android system settings. Each check below shows its live status and opens the screen that fixes it." />

            <!-- Diagnostic sections are built programmatically by SetupActivity
                 so each status can refresh live in onResume. -->
            <LinearLayout
                android:id="@+id/layout_setup_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
