<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoiceVault" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Translucent so a headless Quick Tap toggle can finish with 0ms
             transition before any window surface is ever drawn. The dashboard
             and enrollment layouts paint their own opaque @color/bg background. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.VoiceVault.Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="VoiceVaultClipSlot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_dot</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:drawableTint">@color/text_faint</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/urw_gothic_book</item>
    </style>

    <!-- ===== Shared type and controls (Dashboard, Setup, Enroll) =====
         One family: URW Gothic Demi for labels, titles and numbers; URW
         Gothic Book for reading text. Spacing: 4/8/12/16/24. -->

    <style name="VV" />

    <!-- Screen title: letter-spaced caps, as in the original top bar. -->
    <style name="VV.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/urw_gothic_demi</item>
    </style>

    <style name="VV.Label">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/urw_gothic_demi</item>
    </style>

    <style name="VV.Body">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:fontFamily">@font/urw_gothic_book</item>
    </style>

    <!-- Small state indicator: coloured dot + text, no container. -->
    <style name="VV.Status">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_dot</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:drawableTint">@color/text_faint</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/urw_gothic_book</item>
    </style>

    <style name="VV.IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_muted</item>
    </style>

    <style name="VV.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/urw_gothic_demi</item>
    </style>

    <!-- Text-only action: no fill, still a 48dp target. -->
    <style name="VV.Button.Text">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="VV.Button.Record">
        <item name="android:background">@drawable/bg_btn_record</item>
        <item name="android:textColor">@color/btn_text_on_color</item>
    </style>

    <!-- A Button laid out as a plain settings row. -->
    <style name="VV.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/urw_gothic_book</item>
    </style>
</resources>
