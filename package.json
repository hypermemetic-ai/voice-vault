{
  "name": "voice-vault",
  "version": "1.1.0",
  "description": "Ultra-reliable, local-first asynchronous voice recorder & dictation tool with Whisper Large v3 Turbo on GPU and a two-part speaker-rejection pipeline (Pixel beamforming + server voiceprint gate)",
  "main": "src/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:fast": "node --test test/wav.test.mjs test/vad.test.mjs test/speaker.test.mjs",
    "speaker:list-models": "node scripts/fetch-speaker-model.mjs --list",
    "speaker:fetch-model": "node scripts/fetch-speaker-model.mjs",
    "speaker:setup": "bash scripts/setup-speaker-runtime.sh",
    "verify": "node scripts/verify-ticket.mjs",
    "verify:build-apk": "node scripts/verify-ticket.mjs --build-apk"
  },
  "engines": {
    "node": ">=22"
  }
}
